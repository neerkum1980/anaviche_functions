{
  "mcpServers": {
    "anaviche": {
      "command": "mcp_server/.venv/bin/python",
      "args": ["mcp_server/server.py"],
      "env": {
        "ANAVICHE_BASE_URL": "${ANAVICHE_BASE_URL:-http://localhost:7071/api}",
        "ANAVICHE_FUNCTION_KEY": "${ANAVICHE_FUNCTION_KEY:-}",
        "ANAVICHE_BEARER_TOKEN": "${ANAVICHE_BEARER_TOKEN:-}"
      }
    }
  }
}
